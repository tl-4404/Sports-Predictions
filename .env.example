# SportsAid environment — copy to `.env` and fill in (`make env` does this).
# `.env` is gitignored; never commit real keys.

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
# Put this on persistent storage in hosted environments.
# SPORTSAID_DB_PATH=/var/lib/sportsaid/sportsaid.db

# ── LLM lanes (Claude facts / predictor / judge) ─────────────────────────────
# Get a key at https://console.anthropic.com/. Without it the LLM lanes are
# skipped and the pipeline still runs (sim-only).
ANTHROPIC_API_KEY=
# SPORTSAID_LLM_MODEL=claude-opus-4-8

# ── Odds source toggle: scraper | oddsapi | stub ─────────────────────────────
# scraper = FREE DraftKings + FanDuel (recommended, default here).
# oddsapi = paid The Odds API (props need a paid plan) — set ODDS_API_KEY too.
# stub    = offline fake fixtures (smoke test only).
ODDS_SOURCE=scraper
# MLB_N_SIMS=20000
# MLB_MIN_EDGE=0.06
# MLB_MIN_BOOKS=2
# MLB_MIN_VALIDATION_ROWS=200
# MLB_MAX_AUTO_GAP=0.12

# only used when ODDS_SOURCE=oddsapi
# ODDS_API_KEY=

# scraper knobs (defaults shown) — override if the books' ids/hosts drift.
# SCRAPE_BOOKS=draftkings,fanduel
# DK_MLB_EVENTGROUP=84240
# DK_PITCHER_CATEGORIES=1031
# FD_BASE=https://sbapi.nj.sportsbook.fanduel.com/api/content-managed-page
# FD_MLB_PAGE=mlb

# ── PrizePicks (DFS pick'em lane) ─────────────────────────────────────────────
# Opt in only after setting the jurisdiction and displayed card terms.
PRIZEPICKS_LIVE=0
PRIZEPICKS_STATE_CODE=
# Copy the multipliers displayed for the exact card before each run. The
# pipeline refuses to authorize a card when either value is absent.
PRIZEPICKS_2_PICK_MULTIPLIER=
PRIZEPICKS_TIE_WIN_MULTIPLIER=
# PRIZEPICKS_CARD_MIN_EV=0.08
# PRIZEPICKS_MAX_CARDS=1
# PRIZEPICKS_MLB_LEAGUE_ID=2
# PRIZEPICKS_URL=https://api.prizepicks.com/projections

# ── Admin ─────────────────────────────────────────────────────────────────────
# comma-separated emails allowed to view /admin/tickets
# ADMIN_EMAILS=you@example.com


# -- merged v4.2/v5 audit defaults --
MLB_SHADOW_MODE=1
MLB_MIN_DIAGNOSTIC_ROWS=50
MLB_MIN_VALIDATION_ROWS=200
MLB_FULL_SEGMENT_ROWS=500
MLB_OUTS_OFFICIAL_ENABLED=0
MLB_MAX_OFFICIAL_KS=2
MLB_MAX_LANE_GAP=0.12
MLB_MAX_AUTO_GAP=0.12
SPORTSAID_BATX_MODE=bootstrap_gate
